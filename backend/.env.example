# Copy to backend/.env for local development (git-ignored). On Railway, set these as Variables.

# --- Database / CORS (defaults work locally) ---
# DATABASE_PATH=/data/app.db
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# SEED_ON_STARTUP=true

# --- AI (optional) ---------------------------------------------------------------
# Any OpenAI-compatible provider. Leave LLM_API_KEY empty to run without AI
# (rule-based notes are used and "Ask AI" shows as unavailable).

# Groq (free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
# gpt-oss is a reasoning model: it "thinks" before answering, and thinking counts toward the
# output limit. Without these, Groq stopped it at 2048 tokens mid-notes on longer meetings.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096

# Gemini (free tier): https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<a model name from AI Studio, e.g. a "flash" model>
# LLM_API_KEY=

# OpenAI (paid)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model name>
# LLM_API_KEY=

# Optional tuning
# LLM_REASONING_EFFORT=low     # only for reasoning models; dropped automatically if unsupported
# LLM_MAX_TOKENS=4096          # output budget incl. reasoning; provider default if unset
# LLM_TIMEOUT=45
# LLM_MAX_TRANSCRIPT_CHARS=40000
